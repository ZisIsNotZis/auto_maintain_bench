#!/bin/sh
set -eu
cmd=${1:-}
unit=${2:-}
if [ "$unit" = "demo-scheduler" ] && [ "$cmd" = "status" ]; then
  cat /sandbox/state/demo-scheduler
  exit 0
fi
if [ "$unit" = "demo-scheduler" ] && { [ "$cmd" = "restart" ] || [ "$cmd" = "start" ]; }; then
  if grep -qx 'HEARTBEAT_ENABLED=true' /sandbox/etc/demo-scheduler/scheduler.env; then
    printf 'healthy\n' > /sandbox/state/demo-scheduler
    exit 0
  fi
  printf 'degraded\n' > /sandbox/state/demo-scheduler
  exit 1
fi
printf 'unsupported systemctl command\n' >&2
exit 2
