#!/bin/sh
set -eu
cmd=${1:-}
unit=${2:-}
if [ "$unit" = "demo-api" ] && [ "$cmd" = "status" ]; then
  cat /sandbox/state/demo-api
  exit 0
fi
if [ "$unit" = "demo-api" ] && { [ "$cmd" = "restart" ] || [ "$cmd" = "start" ]; }; then
  if grep -qx 'LOCKFILE_MAX_AGE_S=60' /sandbox/etc/demo-api/lock.env && [ ! -e /sandbox/var/lock/demo-api.pid.lock ]; then
    printf 'healthy\n' > /sandbox/state/demo-api
    exit 0
  fi
  printf 'failed\n' > /sandbox/state/demo-api
  exit 1
fi
printf 'unsupported systemctl command\n' >&2
exit 2
