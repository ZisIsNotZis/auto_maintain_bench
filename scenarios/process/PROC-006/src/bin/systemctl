#!/bin/sh
set -eu
cmd=${1:-}
unit=${2:-}
if [ "$unit" = "demo-api" ] && [ "$cmd" = "status" ]; then
  cat /sandbox/state/demo-api
  exit 0
fi
if [ "$unit" = "demo-api" ] && [ "$cmd" = "is-enabled" ]; then
  grep -qx enabled /sandbox/state/demo-api-enabled
  exit $?
fi
if [ "$unit" = "demo-api" ] && [ "$cmd" = "enable" ]; then
  printf 'enabled\n' > /sandbox/state/demo-api-enabled
  exit 0
fi
if [ "$unit" = "demo-api" ] && { [ "$cmd" = "restart" ] || [ "$cmd" = "start" ]; }; then
  if grep -qx enabled /sandbox/state/demo-api-enabled; then
    printf 'healthy\n' > /sandbox/state/demo-api
    exit 0
  fi
  printf 'stopped\n' > /sandbox/state/demo-api
  exit 1
fi
printf 'unsupported systemctl command\n' >&2
exit 2
