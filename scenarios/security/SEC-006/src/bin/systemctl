#!/bin/sh
set -eu
if [ "${1:-}" = "status" ] && [ "${2:-}" = "web-gateway" ]; then
  cat /sandbox/state/web-gateway
  exit 0
fi
if [ "${1:-}" = "restart" ] && [ "${2:-}" = "web-gateway" ]; then
  if grep -qx "ALLOWED_ORIGINS=https://portal.example.internal" /sandbox/etc/web-gateway/cors.env; then
    printf "secure\n" > /sandbox/state/web-gateway
    exit 0
  fi
  printf "unsafe\n" > /sandbox/state/web-gateway
  exit 1
fi
printf "unsupported systemctl command\n" >&2
exit 2
