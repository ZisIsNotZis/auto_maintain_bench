#!/bin/sh
set -eu
if [ "${1:-}" = "status" ] && [ "${2:-}" = "report-exporter" ]; then
  cat /sandbox/state/report-exporter
  exit 0
fi
if [ "${1:-}" = "restart" ] && [ "${2:-}" = "report-exporter" ]; then
  if grep -qx "umask 077" /sandbox/app/export.sh && grep -qx "tmp=/sandbox/var/tmp/report-exporter/export.tmp" /sandbox/app/export.sh && ! grep -q "chmod 666" /sandbox/app/export.sh; then
    printf "secure\n" > /sandbox/state/report-exporter
    exit 0
  fi
  printf "vulnerable\n" > /sandbox/state/report-exporter
  exit 1
fi
printf "unsupported systemctl command\n" >&2
exit 2
