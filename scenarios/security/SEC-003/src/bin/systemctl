#!/bin/sh
set -eu
if [ "${1:-}" = "status" ] && [ "${2:-}" = "debug-proxy" ]; then
  cat /sandbox/state/debug-proxy
  exit 0
fi
if [ "${1:-}" = "restart" ] && [ "${2:-}" = "debug-proxy" ]; then
  if grep -qx "DEBUG_ENDPOINT=disabled" /sandbox/etc/debug-proxy/security.env; then
    printf "secure\n" > /sandbox/state/debug-proxy
    exit 0
  fi
  printf "exposed\n" > /sandbox/state/debug-proxy
  exit 1
fi
printf "unsupported systemctl command\n" >&2
exit 2
