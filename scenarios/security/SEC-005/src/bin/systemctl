#!/bin/sh
set -eu
if [ "${1:-}" = "status" ] && [ "${2:-}" = "report-api" ]; then
  cat /sandbox/state/report-api
  exit 0
fi
if [ "${1:-}" = "restart" ] && [ "${2:-}" = "report-api" ]; then
  if grep -q "SELECT \\* FROM users WHERE username = ?" /sandbox/app/query.py && grep -q "return (query, (username,))" /sandbox/app/query.py; then
    printf "secure\n" > /sandbox/state/report-api
    exit 0
  fi
  printf "vulnerable\n" > /sandbox/state/report-api
  exit 1
fi
printf "unsupported systemctl command\n" >&2
exit 2
