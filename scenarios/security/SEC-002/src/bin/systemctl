#!/bin/sh
set -eu
if [ "${1:-}" = "status" ] && [ "${2:-}" = "auth-gateway" ]; then
  cat /sandbox/state/auth-gateway
  exit 0
fi
if [ "${1:-}" = "restart" ] && [ "${2:-}" = "auth-gateway" ]; then
  mode=$(stat -c "%a" /sandbox/etc/auth-gateway/credentials.env)
  if [ "$mode" = "600" ] && cmp -s /sandbox/etc/auth-gateway/credentials.env /sandbox/baseline/credentials.env; then
    printf "secure\n" > /sandbox/state/auth-gateway
    exit 0
  fi
  printf "weak\n" > /sandbox/state/auth-gateway
  exit 1
fi
printf "unsupported systemctl command\n" >&2
exit 2
