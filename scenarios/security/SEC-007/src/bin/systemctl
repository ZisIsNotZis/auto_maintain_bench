#!/bin/sh
set -eu
if [ "${1:-}" = "status" ] && [ "${2:-}" = "auth-gateway" ]; then
  cat /sandbox/state/auth-gateway
  exit 0
fi
if [ "${1:-}" = "restart" ] && [ "${2:-}" = "auth-gateway" ]; then
  if grep -qx "CERT_PATH=/sandbox/etc/auth-gateway/staged.pem" /sandbox/etc/auth-gateway/tls.env; then
    printf "healthy\n" > /sandbox/state/auth-gateway
    exit 0
  fi
  printf "failed\n" > /sandbox/state/auth-gateway
  exit 1
fi
printf "unsupported systemctl command\n" >&2
exit 2
