#!/bin/sh
set -eu
if [ "${1:-}" = "status" ] && [ "${2:-}" = "demo-api" ]; then
  cat /sandbox/state/demo-api
  exit 0
fi
if [ "${1:-}" = "restart" ] && [ "${2:-}" = "demo-api" ]; then
  if grep -qx 'API_ENDPOINT=https://us-east.internal.example' /sandbox/etc/demo-api/endpoint.env; then
    printf 'healthy\n' > /sandbox/state/demo-api
    exit 0
  fi
  printf 'degraded\n' > /sandbox/state/demo-api
  exit 1
fi
printf 'unsupported systemctl command\n' >&2
exit 2
