#!/bin/sh
set -eu
if [ "${1:-}" = "status" ] && [ "${2:-}" = "demo-api" ]; then
  cat /sandbox/state/demo-api
  exit 0
fi
if [ "${1:-}" = "restart" ] && [ "${2:-}" = "demo-api" ]; then
  if grep -qx '{"port": 8080}' /sandbox/etc/demo-api/settings.json; then
    printf 'healthy\n' > /sandbox/state/demo-api
    exit 0
  fi
  printf 'failed\n' > /sandbox/state/demo-api
  exit 1
fi
printf 'unsupported systemctl command\n' >&2
exit 2
