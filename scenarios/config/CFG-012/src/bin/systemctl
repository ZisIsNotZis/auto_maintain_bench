#!/bin/sh
set -eu
if [ "${1:-}" = "status" ] && [ "${2:-}" = "admin-api" ]; then
  cat /sandbox/state/admin-api
  exit 0
fi
if [ "${1:-}" = "restart" ] && [ "${2:-}" = "admin-api" ]; then
  if grep -qx 'ENABLE_DEBUG_ADMIN=false' /sandbox/etc/admin-api/admin.env; then
    printf 'healthy\n' > /sandbox/state/admin-api
    exit 0
  fi
  printf 'degraded\n' > /sandbox/state/admin-api
  exit 1
fi
printf 'unsupported systemctl command\n' >&2
exit 2
