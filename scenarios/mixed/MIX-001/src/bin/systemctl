#!/bin/sh
set -eu
if [ "${1:-}" = "status" ] && [ "${2:-}" = "checkout-api" ]; then
  cat /sandbox/state/checkout-api
  exit 0
fi
if [ "${1:-}" = "restart" ] && [ "${2:-}" = "checkout-api" ]; then
  if grep -qx "LOG_BACKOFF_MS=500" /sandbox/etc/checkout-api/backoff.env && test -z "$(find /sandbox/var/log/checkout-api/spam -type f -print -quit)"; then
    printf "healthy\n" > /sandbox/state/checkout-api
    exit 0
  fi
  printf "degraded\n" > /sandbox/state/checkout-api
  exit 1
fi
printf "unsupported systemctl command\n" >&2
exit 2
