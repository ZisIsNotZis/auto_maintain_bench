#!/bin/sh
set -eu
if [ "${1:-}" = "status" ] && [ "${2:-}" = "search-api" ]; then
  cat /sandbox/state/search-api
  exit 0
fi
if [ "${1:-}" = "restart" ] && [ "${2:-}" = "search-api" ]; then
  if grep -qx "UPLOAD_STAGING_TTL_MIN=30" /sandbox/etc/search-api/retention.env && test -z "$(find /sandbox/var/tmp/search-upload -type f -print -quit)" && cmp -s /sandbox/var/cache/search/live.index /sandbox/baseline/live.index; then
    printf "healthy\n" > /sandbox/state/search-api
    exit 0
  fi
  printf "degraded\n" > /sandbox/state/search-api
  exit 1
fi
printf "unsupported systemctl command\n" >&2
exit 2
