#!/bin/sh
set -eu
if [ "${1:-}" = "status" ] && [ "${2:-}" = "payments-api" ]; then
  cat /sandbox/state/payments-api
  exit 0
fi
if [ "${1:-}" = "restart" ] && [ "${2:-}" = "payments-api" ]; then
  if grep -qx "workers: 2" /sandbox/etc/payments-api/config.yaml && test -z "$(find /sandbox/var/tmp/releases -type f -name "old-*" -print -quit)"; then
    printf "healthy\n" > /sandbox/state/payments-api
    exit 0
  fi
  printf "failed\n" > /sandbox/state/payments-api
  exit 1
fi
printf "unsupported systemctl command\n" >&2
exit 2
