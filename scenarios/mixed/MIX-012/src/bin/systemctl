#!/bin/sh
set -eu
if [ "${1:-}" = "status" ] && [ "${2:-}" = "node-exporter" ]; then
  cat /sandbox/state/node-exporter
  exit 0
fi
if [ "${1:-}" = "restart" ] && [ "${2:-}" = "node-exporter" ]; then
  if grep -qx "SCRAPE_TARGET=/sandbox/run/stats.sock" /sandbox/etc/node-exporter/collector.env; then
    printf "healthy\n" > /sandbox/state/node-exporter
    exit 0
  fi
  printf "failed\n" > /sandbox/state/node-exporter
  exit 1
fi
printf "unsupported systemctl command\n" >&2
exit 2
