#!/bin/sh
set -eu
if [ "${1:-}" = "status" ] && [ "${2:-}" = "alerts-api" ]; then
  cat /sandbox/state/alerts-api
  exit 0
fi
if [ "${1:-}" = "restart" ] && [ "${2:-}" = "alerts-api" ]; then
  if cmp -s /sandbox/etc/alerts-api/recent-change.env /sandbox/baseline/recent-change.env && test -z "$(find /sandbox/var/spool/alerts -type f -print -quit)"; then
    printf "healthy\n" > /sandbox/state/alerts-api
    exit 0
  fi
  printf "degraded\n" > /sandbox/state/alerts-api
  exit 1
fi
printf "unsupported systemctl command\n" >&2
exit 2
