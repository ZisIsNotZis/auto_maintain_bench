#!/bin/sh
set -eu
if [ "${1:-}" = "status" ] && [ "${2:-}" = "order-api" ]; then
  cat /sandbox/state/order-api
  exit 0
fi
if [ "${1:-}" = "restart" ] && [ "${2:-}" = "order-api" ]; then
  if grep -qx "RETRY_BACKOFF_MS=250" /sandbox/etc/order-api/retry.env; then
    printf "healthy\n" > /sandbox/state/order-api
    exit 0
  fi
  printf "degraded\n" > /sandbox/state/order-api
  exit 1
fi
printf "unsupported systemctl command\n" >&2
exit 2
