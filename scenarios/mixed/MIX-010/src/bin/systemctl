#!/bin/sh
set -eu
if [ "${1:-}" = "status" ] && [ "${2:-}" = "profile-api" ]; then
  cat /sandbox/state/profile-api
  exit 0
fi
if [ "${1:-}" = "restart" ] && [ "${2:-}" = "profile-api" ]; then
  if grep -qx "CACHE_ONLY_MODE=true" /sandbox/etc/profile-api/fallback.env && grep -qx "RETRY_BACKOFF_MS=1000" /sandbox/etc/profile-api/fallback.env; then
    printf "healthy\n" > /sandbox/state/profile-api
    exit 0
  fi
  printf "degraded\n" > /sandbox/state/profile-api
  exit 1
fi
printf "unsupported systemctl command\n" >&2
exit 2
