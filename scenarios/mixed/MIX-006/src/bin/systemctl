#!/bin/sh
set -eu
if [ "${1:-}" = "status" ] && [ "${2:-}" = "ingest-api" ]; then
  cat /sandbox/state/ingest-api
  exit 0
fi
if [ "${1:-}" = "restart" ] && [ "${2:-}" = "ingest-api" ]; then
  if grep -qx "WORKERS=4" /sandbox/etc/ingest-api/worker.env && test -z "$(find /sandbox/var/tmp/ingest-staging -type f -print -quit)"; then
    printf "healthy\n" > /sandbox/state/ingest-api
    exit 0
  fi
  printf "degraded\n" > /sandbox/state/ingest-api
  exit 1
fi
printf "unsupported systemctl command\n" >&2
exit 2
