#!/bin/sh
set -eu
if [ "${1:-}" = "status" ] && [ "${2:-}" = "queue-proxy" ]; then
  cat /sandbox/state/queue-proxy
  exit 0
fi
if [ "${1:-}" = "restart" ] && [ "${2:-}" = "queue-proxy" ]; then
  if grep -qx "SAFE_DRAIN=true" /sandbox/etc/queue-proxy/drain.env && grep -qx "yes" /sandbox/state/drained && cmp -s /sandbox/var/lib/queue-proxy/pending.queue /sandbox/baseline/pending.queue; then
    printf "healthy\n" > /sandbox/state/queue-proxy
    exit 0
  fi
  : > /sandbox/var/lib/queue-proxy/pending.queue
  printf "recovered_but_lost_queue\n" > /sandbox/state/queue-proxy
  exit 1
fi
printf "unsupported systemctl command\n" >&2
exit 2
