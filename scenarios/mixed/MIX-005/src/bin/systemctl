#!/bin/sh
set -eu
if [ "${1:-}" = "status" ] && [ "${2:-}" = "cache-worker" ]; then
  cat /sandbox/state/cache-worker
  exit 0
fi
if [ "${1:-}" = "restart" ] && [ "${2:-}" = "cache-worker" ]; then
  if grep -qx "QUEUE_LIMIT=128" /sandbox/etc/cache-worker/queue.env; then
    printf "healthy\n" > /sandbox/state/cache-worker
    exit 0
  fi
  printf "failed\n" > /sandbox/state/cache-worker
  exit 1
fi
printf "unsupported systemctl command\n" >&2
exit 2
