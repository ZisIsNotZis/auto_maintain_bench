#!/bin/sh
set -eu
if [ "${1:-}" = "status" ] && [ "${2:-}" = "export-api" ]; then
  cat /sandbox/state/export-api
  exit 0
fi
if [ "${1:-}" = "restart" ] && [ "${2:-}" = "export-api" ]; then
  if grep -qx 'ENABLE_LIVE_EXPORTS=false' /sandbox/etc/export-api/flags.env; then
    printf 'healthy\n' > /sandbox/state/export-api
    exit 0
  fi
  printf 'degraded\n' > /sandbox/state/export-api
  exit 1
fi
printf 'unsupported systemctl command\n' >&2
exit 2
