#!/bin/sh
set -eu
cmd=${1:-}
unit=${2:-demo-api}
unit=${unit%.service}
state_file=/sandbox/state/$unit
case "$cmd" in
  status)
    cat "$state_file"
    ;;
  restart)
    if sh /sandbox/state/restart-check.sh; then
      printf 'healthy
' > "$state_file"
      exit 0
    fi
    if [ -f /sandbox/state/fail-state ]; then
      cat /sandbox/state/fail-state > "$state_file"
    else
      printf 'degraded
' > "$state_file"
    fi
    exit 1
    ;;
  *)
    printf 'unsupported systemctl command
' >&2
    exit 2
    ;;
esac
