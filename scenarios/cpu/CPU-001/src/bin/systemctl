#!/bin/sh
set -eu
service="${2:-}"
if [ "$service" = "demo-api.service" ]; then
  service="demo-api"
fi
if [ "${1:-}" = "status" ] && [ "$service" = "demo-api" ]; then
  cat /sandbox/state/demo-api
  exit 0
fi
if [ "${1:-}" = "restart" ] && [ "$service" = "demo-api" ]; then
  value=$(sed -n 's/^WORKER_MULTIPLIER=//p' /sandbox/etc/demo-api/worker.env)
  if [ -n "$value" ] && [ "$value" -le 4 ]; then
    printf 'healthy\n' > /sandbox/state/demo-api
    exit 0
  fi
  printf 'degraded\n' > /sandbox/state/demo-api
  exit 1
fi
printf 'unsupported systemctl command\n' >&2
exit 2
