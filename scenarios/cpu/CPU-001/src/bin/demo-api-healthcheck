#!/bin/sh
set -eu
value=$(sed -n 's/^WORKER_MULTIPLIER=//p' /sandbox/etc/demo-api/worker.env)
state=$(cat /sandbox/state/demo-api)
if [ "$value" = "2" ] && [ "$state" = "healthy" ]; then
  printf 'verification_passed\n'
  exit 0
fi
printf 'verification_failed value=%s state=%s\n' "$value" "$state" >&2
exit 1
