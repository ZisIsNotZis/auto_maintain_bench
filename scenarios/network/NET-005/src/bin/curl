#!/bin/sh
set -eu
url=''
for arg in "$@"; do
  case "$arg" in
    -*) ;;
    *) url=$arg ;;
  esac
done
if [ "$url" = "http://127.0.0.1:8080/health" ]; then
  if grep -qx healthy /sandbox/state/demo-api; then
    printf '{"status":"ok"}\n'
    exit 0
  fi
  printf 'curl: (22) The requested URL returned error: 503\n' >&2
  exit 22
fi
            if [ "$url" = "https://auth.internal/check" ]; then
              if grep -qx 'CLIENT_TIME_OFFSET_S=0' /sandbox/etc/demo-api/client-time.env; then
                printf 'ok
'
                exit 0
              fi
              printf 'curl: (22) The requested URL returned error: 401
' >&2
              exit 22
            fi
printf 'curl: unsupported url %s\n' "$url" >&2
exit 22
