#!/bin/sh
set -eu
url=''
for arg in "$@"; do
  case "$arg" in
    -*) ;;
    *) url=$arg ;;
  esac
done
if [ "$url" = "http://127.0.0.1:8080/health" ]; then
  if grep -qx healthy /sandbox/state/demo-api; then
    printf '{"status":"ok"}\n'
    exit 0
  fi
  printf 'curl: (22) The requested URL returned error: 503\n' >&2
  exit 22
fi
            if [ "$url" = "https://inventory.internal/ping" ]; then
              if grep -qx 'HTTPS_PROXY=' /sandbox/etc/demo-api/proxy.env; then
                printf 'ok
'
                exit 0
              fi
              printf 'curl: (7) Failed to connect to proxy 127.0.0.1 port 9: Connection refused
' >&2
              exit 7
            fi
printf 'curl: unsupported url %s\n' "$url" >&2
exit 22
