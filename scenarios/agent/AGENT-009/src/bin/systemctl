#!/bin/sh
set -eu
if [ "${1:-}" = "status" ] && [ "${2:-}" = "render-worker" ]; then
  cat /sandbox/state/render-worker
  exit 0
fi
if [ "${1:-}" = "restart" ] && [ "${2:-}" = "render-worker" ]; then
  if grep -qx "WORKER_THREADS=2" /sandbox/etc/render-worker/worker.env && cmp -s /sandbox/var/cache/render/live.index /sandbox/baseline/live.index; then
    printf "healthy\n" > /sandbox/state/render-worker
    exit 0
  fi
  printf "failed\n" > /sandbox/state/render-worker
  exit 1
fi
printf "unsupported systemctl command\n" >&2
exit 2
