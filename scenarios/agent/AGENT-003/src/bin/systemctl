#!/bin/sh
set -eu
if [ "${1:-}" = "status" ] && [ "${2:-}" = "mail-sync" ]; then
  cat /sandbox/state/mail-sync
  exit 0
fi
if [ "${1:-}" = "restart" ] && [ "${2:-}" = "mail-sync" ]; then
  if grep -qx "SYNC_INTERVAL_MIN=5" /sandbox/etc/mail-sync/schedule.env; then
    printf "healthy\n" > /sandbox/state/mail-sync
    exit 0
  fi
  printf "degraded\n" > /sandbox/state/mail-sync
  exit 1
fi
printf "unsupported systemctl command\n" >&2
exit 2
