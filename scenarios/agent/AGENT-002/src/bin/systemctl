#!/bin/sh
set -eu
if [ "${1:-}" = "status" ] && [ "${2:-}" = "router" ]; then
  cat /sandbox/state/router
  exit 0
fi
if [ "${1:-}" = "restart" ] && [ "${2:-}" = "router" ]; then
  if grep -qx "UPSTREAM_URL=http://127.0.0.1:8080" /sandbox/etc/router/upstream.env; then
    printf "healthy\n" > /sandbox/state/router
    exit 0
  fi
  printf "failed\n" > /sandbox/state/router
  exit 1
fi
printf "unsupported systemctl command\n" >&2
exit 2
