#!/bin/sh
set -eu
if [ "${1:-}" = "status" ] && [ "${2:-}" = "cache-worker" ]; then
  cat /sandbox/state/cache-worker
  exit 0
fi
if [ "${1:-}" = "restart" ] && [ "${2:-}" = "cache-worker" ]; then
  count=$(cat /sandbox/state/restart-count)
  count=$((count + 1))
  printf "%s\n" "$count" > /sandbox/state/restart-count
  if grep -qx "MODE=steady" /sandbox/etc/cache-worker/mode.env && [ -f /sandbox/var/lib/cache-worker/pending.job ]; then
    printf "healthy\n" > /sandbox/state/cache-worker
    exit 0
  fi
  if [ "$count" -ge 2 ]; then
    rm -f /sandbox/var/lib/cache-worker/pending.job
  fi
  printf "degraded\n" > /sandbox/state/cache-worker
  exit 1
fi
printf "unsupported systemctl command\n" >&2
exit 2
