#!/bin/sh
set -eu
if [ "${1:-}" = "status" ] && [ "${2:-}" = "thumb-cache" ]; then
  cat /sandbox/state/thumb-cache
  exit 0
fi
if [ "${1:-}" = "restart" ] && [ "${2:-}" = "thumb-cache" ]; then
  if grep -qx "CACHE_TTL_SECONDS=300" /sandbox/etc/thumb-cache/cache.env && cmp -s /sandbox/var/cache/thumb-cache/live.index /sandbox/baseline/live.index; then
    printf "healthy\n" > /sandbox/state/thumb-cache
    exit 0
  fi
  printf "degraded\n" > /sandbox/state/thumb-cache
  exit 1
fi
printf "unsupported systemctl command\n" >&2
exit 2
