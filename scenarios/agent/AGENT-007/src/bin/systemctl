#!/bin/sh
set -eu
if [ "${1:-}" = "status" ] && [ "${2:-}" = "logshipper" ]; then
  cat /sandbox/state/logshipper
  exit 0
fi
if [ "${1:-}" = "restart" ] && [ "${2:-}" = "logshipper" ]; then
  if grep -qx "ENABLE_GZIP=true" /sandbox/etc/logshipper/options.env; then
    printf "healthy\n" > /sandbox/state/logshipper
    exit 0
  fi
  printf "failed\n" > /sandbox/state/logshipper
  exit 1
fi
printf "unsupported systemctl command\n" >&2
exit 2
