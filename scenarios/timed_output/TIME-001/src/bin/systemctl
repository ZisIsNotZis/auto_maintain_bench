#!/bin/sh
set -eu
if [ "${1:-}" = "status" ] && [ "${2:-}" = "worker" ]; then
  cat /sandbox/state/worker
  exit 0
fi
if [ "${1:-}" = "restart" ] && [ "${2:-}" = "worker" ]; then
  if grep -qx "HEARTBEAT_ENABLED=true" /sandbox/etc/worker/heartbeat.env; then
    printf "2026-07-22T07:30:00Z heartbeat\n" >> /sandbox/var/lib/worker/heartbeat.log
    printf "healthy\n" > /sandbox/state/worker
    exit 0
  fi
  printf "degraded\n" > /sandbox/state/worker
  exit 1
fi
printf "unsupported systemctl command\n" >&2
exit 2
