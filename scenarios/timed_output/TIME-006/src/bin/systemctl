#!/bin/sh
set -eu
if [ "${1:-}" = "status" ] && [ "${2:-}" = "queue-consumer" ]; then
  cat /sandbox/state/queue-consumer
  exit 0
fi
if [ "${1:-}" = "restart" ] && [ "${2:-}" = "queue-consumer" ]; then
  if grep -qx "ACK_ENABLED=true" /sandbox/etc/queue-consumer/ack.env; then
    printf "2026-07-22T07:35:00Z ack job-38\n" >> /sandbox/var/lib/queue-consumer/acks.log
    printf "healthy\n" > /sandbox/state/queue-consumer
    exit 0
  fi
  printf "degraded\n" > /sandbox/state/queue-consumer
  exit 1
fi
printf "unsupported systemctl command\n" >&2
exit 2
