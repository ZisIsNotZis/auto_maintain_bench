#!/bin/sh
set -eu
if [ "${1:-}" = "status" ] && [ "${2:-}" = "batch-writer" ]; then
  cat /sandbox/state/batch-writer
  exit 0
fi
if [ "${1:-}" = "restart" ] && [ "${2:-}" = "batch-writer" ]; then
  if grep -qx "WRITE_OUTPUT=true" /sandbox/etc/batch-writer/job.env; then
    mkdir -p /sandbox/var/output
    printf "id,value\n1,ok\n" > /sandbox/var/output/2026-07-22.csv
    printf "2026-07-22T07:31:00Z\n" > /sandbox/var/lib/batch-writer/last-run.txt
    printf "healthy\n" > /sandbox/state/batch-writer
    exit 0
  fi
  printf "degraded\n" > /sandbox/state/batch-writer
  exit 1
fi
printf "unsupported systemctl command\n" >&2
exit 2
