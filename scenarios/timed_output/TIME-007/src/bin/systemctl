#!/bin/sh
set -eu
if [ "${1:-}" = "status" ] && [ "${2:-}" = "backup-job" ]; then
  cat /sandbox/state/backup-job
  exit 0
fi
if [ "${1:-}" = "restart" ] && [ "${2:-}" = "backup-job" ]; then
  if grep -qx "BACKUP_ENABLED=true" /sandbox/etc/backup-job/backup.env; then
    printf "backup-ok\n" > /sandbox/var/backups/backup-2026-07-22.tar
    printf "2026-07-22T07:36:00Z\n" > /sandbox/var/backups/last-success.txt
    printf "healthy\n" > /sandbox/state/backup-job
    exit 0
  fi
  printf "degraded\n" > /sandbox/state/backup-job
  exit 1
fi
printf "unsupported systemctl command\n" >&2
exit 2
