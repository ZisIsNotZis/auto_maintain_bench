#!/bin/sh
set -eu
if [ "${1:-}" = "status" ] && [ "${2:-}" = "delivery-job" ]; then
  cat /sandbox/state/delivery-job
  exit 0
fi
if [ "${1:-}" = "restart" ] && [ "${2:-}" = "delivery-job" ]; then
  if grep -qx "DELIVERY_MODE=deliver" /sandbox/etc/delivery-job/delivery.env && [ -f /sandbox/var/reports/daily-2026-07-22.txt ]; then
    mkdir -p /sandbox/var/outbox
    mv /sandbox/var/reports/daily-2026-07-22.txt /sandbox/var/outbox/sent-2026-07-22.txt
    printf "healthy\n" > /sandbox/state/delivery-job
    exit 0
  fi
  printf "degraded\n" > /sandbox/state/delivery-job
  exit 1
fi
printf "unsupported systemctl command\n" >&2
exit 2
