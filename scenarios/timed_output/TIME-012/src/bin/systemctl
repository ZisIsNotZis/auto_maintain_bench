#!/bin/sh
set -eu
if [ "${1:-}" = "status" ] && [ "${2:-}" = "dst-job" ]; then
  cat /sandbox/state/dst-job
  exit 0
fi
if [ "${1:-}" = "restart" ] && [ "${2:-}" = "dst-job" ]; then
  if grep -qx "DST_DUPLICATE_POLICY=skip_duplicate" /sandbox/etc/dst-job/schedule.env && cmp -s /sandbox/var/lib/dst-job/run-history.log /sandbox/baseline/run-history.log; then
    printf "skip_duplicate\n" > /sandbox/var/lib/dst-job/next-policy.txt
    printf "healthy\n" > /sandbox/state/dst-job
    exit 0
  fi
  printf "degraded\n" > /sandbox/state/dst-job
  exit 1
fi
printf "unsupported systemctl command\n" >&2
exit 2
