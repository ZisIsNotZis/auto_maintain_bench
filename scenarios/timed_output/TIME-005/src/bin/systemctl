#!/bin/sh
set -eu
if [ "${1:-}" = "status" ] && [ "${2:-}" = "app-loader" ]; then
  cat /sandbox/state/app-loader
  exit 0
fi
if [ "${1:-}" = "restart" ] && [ "${2:-}" = "app-loader" ]; then
  if grep -qx "BOOT_TIMEOUT_S=30" /sandbox/etc/app-loader/start.env; then
    printf "ready\n" >> /sandbox/var/log/app-loader/startup.log
    printf "healthy\n" > /sandbox/state/app-loader
    exit 0
  fi
  printf "starting\n" > /sandbox/state/app-loader
  exit 1
fi
printf "unsupported systemctl command\n" >&2
exit 2
