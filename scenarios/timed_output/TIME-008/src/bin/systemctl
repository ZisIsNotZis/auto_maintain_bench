#!/bin/sh
set -eu
if [ "${1:-}" = "status" ] && [ "${2:-}" = "token-renewer" ]; then
  cat /sandbox/state/token-renewer
  exit 0
fi
if [ "${1:-}" = "restart" ] && [ "${2:-}" = "token-renewer" ]; then
  if grep -qx "AUTO_REFRESH=true" /sandbox/etc/token-renewer/job.env; then
    printf "expires_at=2026-07-23T06:40:00Z\nrefreshed_at=2026-07-22T07:37:00Z\n" > /sandbox/var/lib/token-renewer/token.meta
    printf "healthy\n" > /sandbox/state/token-renewer
    exit 0
  fi
  printf "degraded\n" > /sandbox/state/token-renewer
  exit 1
fi
printf "unsupported systemctl command\n" >&2
exit 2
