#!/bin/sh
set -eu
if [ "${1:-}" = "status" ] && [ "${2:-}" = "report-cron" ]; then
  cat /sandbox/state/report-cron
  exit 0
fi
if [ "${1:-}" = "restart" ] && [ "${2:-}" = "report-cron" ]; then
  if grep -qx "CRON_TZ=America/Los_Angeles" /sandbox/etc/report-cron/schedule.env; then
    printf "2026-07-22T16:00:00-07:00\n" > /sandbox/var/lib/report-cron/next-run.txt
    printf "healthy\n" > /sandbox/state/report-cron
    exit 0
  fi
  printf "degraded\n" > /sandbox/state/report-cron
  exit 1
fi
printf "unsupported systemctl command\n" >&2
exit 2
