#!/bin/sh
set -eu
if [ "${1:-}" = "status" ] && [ "${2:-}" = "slow-app" ]; then
  cat /sandbox/state/slow-app
  exit 0
fi
if [ "${1:-}" = "restart" ] && [ "${2:-}" = "slow-app" ]; then
  if grep -qx "STARTUP_GRACE_S=60" /sandbox/etc/slow-app/start.env; then
    printf "ready\n" >> /sandbox/var/log/slow-app/startup.log
    printf "healthy\n" > /sandbox/state/slow-app
    exit 0
  fi
  printf "starting\n" > /sandbox/state/slow-app
  exit 1
fi
printf "unsupported systemctl command\n" >&2
exit 2
