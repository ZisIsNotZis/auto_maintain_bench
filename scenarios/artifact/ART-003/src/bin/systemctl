#!/bin/sh
set -eu
if [ "${1:-}" = "status" ] && [ "${2:-}" = "worker-api" ]; then
  cat /sandbox/state/worker-api
  exit 0
fi
if [ "${1:-}" = "restart" ] && [ "${2:-}" = "worker-api" ]; then
  if grep -qx 'user_id = payload["id"]' /sandbox/srv/worker/process_user.py; then
    printf 'healthy\n' > /sandbox/state/worker-api
    exit 0
  fi
  printf 'degraded\n' > /sandbox/state/worker-api
  exit 1
fi
printf 'unsupported systemctl command\n' >&2
exit 2
