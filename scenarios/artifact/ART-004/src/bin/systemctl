#!/bin/sh
set -eu
if [ "${1:-}" = "status" ] && [ "${2:-}" = "frontend-renderer" ]; then
  cat /sandbox/state/frontend-renderer
  exit 0
fi
if [ "${1:-}" = "restart" ] && [ "${2:-}" = "frontend-renderer" ]; then
  if grep -qx '  const profile = await loadProfile();' /sandbox/var/www/static/profile.js; then
    printf 'healthy\n' > /sandbox/state/frontend-renderer
    exit 0
  fi
  printf 'degraded\n' > /sandbox/state/frontend-renderer
  exit 1
fi
printf 'unsupported systemctl command\n' >&2
exit 2
