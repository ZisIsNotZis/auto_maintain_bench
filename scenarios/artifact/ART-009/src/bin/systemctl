#!/bin/sh
set -eu
if [ "${1:-}" = "status" ] && [ "${2:-}" = "demo-stack" ]; then
  cat /sandbox/state/demo-stack
  exit 0
fi
if [ "${1:-}" = "restart" ] && [ "${2:-}" = "demo-stack" ]; then
  if grep -qx '      - APP_ENV=staging' /sandbox/deploy/docker-compose.yml; then
    printf 'healthy\n' > /sandbox/state/demo-stack
    exit 0
  fi
  printf 'degraded\n' > /sandbox/state/demo-stack
  exit 1
fi
printf 'unsupported systemctl command\n' >&2
exit 2
