#!/bin/sh
set -eu
if [ "${1:-}" = "status" ] && [ "${2:-}" = "report-publisher" ]; then
  cat /sandbox/state/report-publisher
  exit 0
fi
if [ "${1:-}" = "restart" ] && [ "${2:-}" = "report-publisher" ]; then
  if grep -qx 'cp "$SOURCE_FILE" "$TARGET_DIR/report.txt"' /sandbox/bin/publish-report.sh; then
    printf 'healthy\n' > /sandbox/state/report-publisher
    exit 0
  fi
  printf 'degraded\n' > /sandbox/state/report-publisher
  exit 1
fi
printf 'unsupported systemctl command\n' >&2
exit 2
