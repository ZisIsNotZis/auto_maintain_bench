#!/bin/sh
set -eu
url=''
for arg in "$@"; do
  case "$arg" in
    -*) ;;
    *) url=$arg ;;
  esac
done
if [ "$url" = "http://127.0.0.1:8080/health" ]; then
  if grep -qx healthy /sandbox/state/demo-api; then
    printf '{"status":"ok"}\n'
    exit 0
  fi
  printf 'curl: (22) The requested URL returned error: 503\n' >&2
  exit 22
fi
            if [ "$url" = "http://127.0.0.1:8080/live" ]; then
              printf '{"status":"live"}
'
              exit 0
            fi
            if [ "$url" = "http://127.0.0.1:8080/ready" ]; then
              if grep -qx 'READINESS_GATE=queue_depth' /sandbox/etc/demo-api/health.env; then
                printf '{"status":"ready"}
'
                exit 0
              fi
              printf 'curl: (22) The requested URL returned error: 503
' >&2
              exit 22
            fi
printf 'curl: unsupported url %s\n' "$url" >&2
exit 22
