#!/bin/sh
set -eu
if [ "${1:-}" = "status" ] && [ "${2:-}" = "sqlite-proxy" ]; then
  cat /sandbox/state/sqlite-proxy
  exit 0
fi
if [ "${1:-}" = "restart" ] && [ "${2:-}" = "sqlite-proxy" ]; then
  if grep -qx 'AUTO_CHECKPOINT=1' /sandbox/etc/db/checkpoint.env && test ! -e /sandbox/var/db/app.wal; then
    printf 'healthy\n' > /sandbox/state/sqlite-proxy
    exit 0
  fi
  printf 'degraded\n' > /sandbox/state/sqlite-proxy
  exit 1
fi
printf 'unsupported systemctl command\n' >&2
exit 2
