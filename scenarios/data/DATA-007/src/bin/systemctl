#!/bin/sh
set -eu
if [ "${1:-}" = "status" ] && [ "${2:-}" = "queue-worker" ]; then
  cat /sandbox/state/queue-worker
  exit 0
fi
if [ "${1:-}" = "restart" ] && [ "${2:-}" = "queue-worker" ]; then
  if ! grep -q 'BAD_JSON' /sandbox/var/queue/payments.txt && grep -qx 'job-2:BAD_JSON' /sandbox/var/queue/dead-letter.txt; then
    printf 'healthy\n' > /sandbox/state/queue-worker
    exit 0
  fi
  printf 'degraded\n' > /sandbox/state/queue-worker
  exit 1
fi
printf 'unsupported systemctl command\n' >&2
exit 2
