#!/bin/sh
set -eu
if [ "${1:-}" = "status" ] && [ "${2:-}" = "analytics-api" ]; then
  cat /sandbox/state/analytics-api
  exit 0
fi
if [ "${1:-}" = "restart" ] && [ "${2:-}" = "analytics-api" ]; then
  if grep -qx 'orders,customer_id' /sandbox/var/db/analytics.indexes; then
    printf 'healthy\n' > /sandbox/state/analytics-api
    exit 0
  fi
  printf 'degraded\n' > /sandbox/state/analytics-api
  exit 1
fi
printf 'unsupported systemctl command\n' >&2
exit 2
