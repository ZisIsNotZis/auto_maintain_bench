#!/bin/sh
set -eu
if [ "${1:-}" = "status" ] && [ "${2:-}" = "orders-api" ]; then
  cat /sandbox/state/orders-api
  exit 0
fi
if [ "${1:-}" = "restart" ] && [ "${2:-}" = "orders-api" ]; then
  if test ! -e /sandbox/var/db/orders.db.lock; then
    printf 'healthy\n' > /sandbox/state/orders-api
    exit 0
  fi
  printf 'degraded\n' > /sandbox/state/orders-api
  exit 1
fi
printf 'unsupported systemctl command\n' >&2
exit 2
