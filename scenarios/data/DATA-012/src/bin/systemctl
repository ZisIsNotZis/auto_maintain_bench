#!/bin/sh
set -eu
if [ "${1:-}" = "status" ] && [ "${2:-}" = "batch-reader" ]; then
  cat /sandbox/state/batch-reader
  exit 0
fi
if [ "${1:-}" = "restart" ] && [ "${2:-}" = "batch-reader" ]; then
  if grep -qx 'mode=0640' /sandbox/var/db/batch-results.acl; then
    printf 'healthy\n' > /sandbox/state/batch-reader
    exit 0
  fi
  printf 'degraded\n' > /sandbox/state/batch-reader
  exit 1
fi
printf 'unsupported systemctl command\n' >&2
exit 2
